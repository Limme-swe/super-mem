{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "supermem",
            "args": ["hook", "claude"],
            "timeout": 8,
            "statusMessage": "Loading memory"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "supermem",
            "args": ["hook", "claude"],
            "timeout": 8,
            "statusMessage": "Recalling memory"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "supermem",
            "args": ["hook", "claude"],
            "timeout": 8
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(?!mcp__super_mem__).*$",
        "hooks": [
          {
            "type": "command",
            "command": "supermem",
            "args": ["hook", "claude"],
            "timeout": 8
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^(?!mcp__super_mem__).*$",
        "hooks": [
          {
            "type": "command",
            "command": "supermem",
            "args": ["hook", "claude"],
            "timeout": 8
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "supermem",
            "args": ["hook", "claude"],
            "timeout": 8
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "supermem",
            "args": ["hook", "claude"],
            "timeout": 8
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "supermem",
            "args": ["hook", "claude"],
            "timeout": 8
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "supermem",
            "args": ["hook", "claude"],
            "timeout": 8
          }
        ]
      }
    ]
  }
}
